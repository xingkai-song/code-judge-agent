{
  "id": "max_subarray",
  "title": "最大子段和",
  "statement": "读入 n 和 n 个整数，输出连续子段和的最大值。子段不能为空。",
  "time_limit_ms": 2000,
  "memory_limit_mb": 256,
  "checker": "token",
  "tags": ["动态规划", "经典"],
  "difficulty": "medium",
  "source": "sample",
  "cases": [
    { "id": "c1", "stdin": "5\n1 -2 3 4 -1\n", "expected_stdout": "7\n" },
    {
      "id": "c2",
      "stdin": "3\n-1 -2 -3\n",
      "expected_stdout": "-1\n",
      "note": "全负数：把答案初始化成 0 的写法会错在这里"
    },
    { "id": "c3", "stdin": "1\n5\n", "expected_stdout": "5\n" },
    { "id": "c4", "stdin": "6\n-2 1 -3 4 -1 2\n", "expected_stdout": "5\n" }
  ]
}
